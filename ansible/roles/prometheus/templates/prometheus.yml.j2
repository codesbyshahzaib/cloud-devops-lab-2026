global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - "/etc/prometheus/prometheus.rules.yml"

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node-exporter'
    static_configs:
      - targets: ['node-exporter:9100']

  - job_name: 'jenkins'
    metrics_path: '/jenkins/prometheus/'
    static_configs:
      - targets: ['jenkins:8080']

  - job_name: 'sonarqube'
    metrics_path: '/sonar/api/monitoring/metrics'
    bearer_token: '{{ vault_sonar_passcode }}'
    static_configs:
      - targets: ['sonarqube:9000']

  - job_name: 'sonar-exporter'
    static_configs:
      - targets: ['sonar_exporter:9101']

