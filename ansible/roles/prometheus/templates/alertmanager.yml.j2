global:
  resolve_timeout: 5m

route:
  group_by: ['alertname']
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h
  receiver: 'slack-mock'

receivers:
  - name: 'slack-mock'
    slack_configs:
      - api_url: 'http://mock-slack.localdomain/alerts'
        channel: '#devops-alerts'
        title: '{{ template "slack.default.title" . }}'
        text: '{{ template "slack.default.text" . }}'
        send_resolved: true
