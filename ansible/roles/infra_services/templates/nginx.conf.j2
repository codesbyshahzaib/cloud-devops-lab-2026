events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    client_max_body_size 100M;

    server {
        listen 80;
        server_name localhost;

        # Node Application (Root)
        location / {
            resolver 127.0.0.11 valid=30s;
            set $app_backend "http://node-app:3000";
            proxy_pass $app_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # Support basic error page handling
            error_page 502 /502.html;
            location = /502.html {
                root /usr/share/nginx/html;
                internal;
            }
        }

        # Jenkins
        location /jenkins/ {
            resolver 127.0.0.11 valid=30s;
            set $jenkins_backend "http://jenkins:8080";
            proxy_pass $jenkins_backend;
            proxy_set_header Host jenkins:8080;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_read_timeout 90;
            proxy_redirect http://jenkins:8080/ /;

            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        location = /jenkins {
            return 301 $scheme://$http_host/jenkins/;
        }

        # SonarQube
        location /sonar/ {
            proxy_pass http://sonarqube:9000/sonar/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /sonar {
            return 301 $scheme://$http_host/sonar/;
        }

        # Grafana
        location /grafana {
            resolver 127.0.0.11 valid=30s;
            set $grafana_backend "http://grafana:3000";
            proxy_pass $grafana_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # Websocket support
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }
}
